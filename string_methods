#  3.input_word == reverse_word
#  4. confirmed palindrome



def palindrome(word):
    reverse_word=''
    start_index=len(word)-1
    for i in range(start_index,-1, -1):
        reverse_word = reverse_word+word[i]
    if reverse_word == word:
        print(f"its a palindrom : {word}: {reverse_word}")
    else:
        print(f"its not a palindrome:{word}: {reverse_word}")


